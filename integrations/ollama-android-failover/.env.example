# Copy to .env and set your local addresses and model names.
# Never commit .env or real API keys.

HOST=127.0.0.1
PORT=3001

# Set a long random token before allowing any LAN access.
# Requests must include: Authorization: Bearer <API_TOKEN>
API_TOKEN=replace-with-a-long-random-secret

AI_TARGET=auto
AI_TIMEOUT_MS=20000
AI_MAX_TOKENS=512

PC_AI_URL=http://192.168.1.39:11434
PC_AI_MODEL=damsvautrain/ani-vautrain:latest

ANDROID_AI_URL=http://192.168.1.99:12434
ANDROID_AI_MODEL=llama3.2:3b
ANDROID_AI_API_KEY=
